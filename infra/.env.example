REDIS_URL=redis://localhost:6379
SECRET_KEY=your_jwt_secret_here_change_in_prod
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================
# INFERENCE SERVICE
# ============================
INFERENCE_SERVICE_PORT=8001
MODEL_PATH=models/sign_classifier.onnx
CONFIDENCE_THRESHOLD=0.6
WINDOW_SIZE=30
DUMMY_MODE=true  # Set false once real ONNX model is available

# ============================
# EXTERNAL APIs (Optional - mocked in dev if not set)
# ============================

# Claude API (LLM sentence correction)
ANTHROPIC_API_KEY=your_claude_api_key_here

# Google Cloud Translation + TTS
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Azure Speech (alternative TTS)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# ============================
# FRONTEND (Vite env vars — must be prefixed VITE_)
# ============================
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_ENABLE_MOCK_CAPTIONS=true
